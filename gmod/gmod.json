{
  "type": "srcds",
  "display": "Garry's Mod",
  "icon": "gmod",
  "data": {
    "gamemode": {
      "type": "string",
      "value": "sandbox",
      "display": "ゲームモード",
      "desc": "読み込むゲームモード",
      "required": true,
      "userEdit": true
    },
    "mapname": {
      "type": "string",
      "value": "gm_construct",
      "display": "マップ",
      "desc": "デフォルトで読み込むマップ",
      "required": true,
      "userEdit": true
    },
    "maxplayers": {
      "type": "integer",
      "value": 20,
      "display": "最大プレイヤー数",
      "desc": "サーバーへの最大同時参加人数",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "ポート",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "steamaccounttoken": {
      "type": "string",
      "value": "",
      "display": "Steamゲームサーバーアカウントトークン",
      "desc": "ゲームサーバーアカウント用のトークン。*任意* (こちらで取得可能: https://steamcommunity.com/dev/managegameservers)",
      "required": false,
      "userEdit": true
    },
    "wscollection": {
      "type": "string",
      "value": "",
      "display": "ワークショップコレクションID",
      "desc": "サーバーが読み込むべきワークショップコレクションIDを指定します。*任意*",
      "required": false,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 4020 +quit"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x srcds_run"
      ]
    }
  ],
  "run": {
    "command": "./srcds_run +port ${port} -game garrysmod -console +gamemode ${gamemode} +map ${mapname} +maxplayers ${maxplayers} +host_workshop_collection ${wscollection} +sv_setsteamaccount ${steamaccounttoken} -norestart",
    "stop": "exit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
