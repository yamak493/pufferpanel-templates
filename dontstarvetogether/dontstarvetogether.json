{
  "type": "srcds",
  "display": "Dont Starve Together",
  "icon": "dontstarvetogether",
  "data": {
    "description": {
      "type": "string",
      "value": "Dont Starve Together Server",
      "display": "サーバーの説明",
      "desc": "サーバーの詳細説明",
      "required": true,
      "userEdit": true
    },
    "gamemode": {
      "type": "option",
      "value": "",
      "display": "ゲームモード",
      "desc": "プレイしたいゲームモードを選択してください",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "survival",
          "display": "サバイバル"
        },
        {
          "value": "wilderness",
          "display": "ウィルダネス"
        },
        {
          "value": "endless",
          "display": "エンドレス"
        }
      ]
    },
    "gamestyle": {
      "type": "option",
      "value": "",
      "display": "ゲームスタイル",
      "desc": "サーバーでどのようにプレイしたいですか？",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "social",
          "display": "ソーシャル"
        },
        {
          "value": "cooperative",
          "display": "協力（Cooperative）"
        },
        {
          "value": "competetive",
          "display": "対戦（Competetive）"
        },
        {
          "value": "madness",
          "display": "マッドネス"
        }
      ]
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": true
    },
    "maxplayers": {
      "type": "integer",
      "value": 5,
      "display": "最大プレイヤー数",
      "desc": "サーバーに接続可能な最大プレイヤー人数",
      "required": true,
      "userEdit": true
    },
    "password": {
      "type": "string",
      "value": "",
      "display": "パスワード",
      "desc": "（任意）サーバーに接続するために必要なパスワード。不要な場合は空欄のままにしてください",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 10889,
      "display": "ポート",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": true
    },
    "pvp": {
      "type": "boolean",
      "value": false,
      "display": "PvP",
      "desc": "サーバー上でPvPを有効にしますか？",
      "required": true,
      "userEdit": true
    },
    "servername": {
      "type": "string",
      "value": "DDTServer",
      "display": "ServerName",
      "desc": "Display Name for the Server",
      "required": true,
      "userEdit": true
    },
    "servertoken": {
      "type": "string",
      "value": "",
      "display": "Server Token",
      "desc": "Dont Starve Together Server Token (may find here <a href=\"https://accounts.klei.com/account/game/servers?game=DontStarveTogether\" target=\"_blank\">here</a>)",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "343050"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 343050 +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": "DoNotStarveTogether/DontStarveTogetherServer"
    },
    {
      "type": "writefile",
      "target": "DoNotStarveTogether/DontStarveTogetherServer/cluster_token.txt",
      "text": "${servertoken}"
    },
    {
      "type": "writefile",
      "text": "[GAMEPLAY]\ngame_mode = ${gamemode}\nmax_players = ${maxplayers}\npvp = ${pvp}\npause_when_empty = true\n\n[NETWORK]\ncluster_description = ${description}\ncluster_name = ${servername}\ncluster_intention = ${gamestyle}\ncluster_password = ${password}\n\n[MISC]\nconsole_enabled = true\n\n[SHARD]\nshard_enabled = true\nbind_ip = ${ip}\nmaster_ip = ${ip}\nmaster_port = ${port}\ncluster_key = ${servertoken}",
      "target": "DoNotStarveTogether/DontStarveTogetherServer/cluster.ini"
    }
  ],
  "run": {
    "command": "./dontstarve_dedicated_server_nullrenderer -persistent_storage_root . -console -cluster \"DontStarveTogetherServer\" -monitor_parent_process",
    "stop": "c_shutdown()",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
