{
  "type": "minecraft-java",
  "display": "Minecraft（Java版）[Forge]",
  "icon": "minecraft-java",
  "data": {
    "eula": {
      "type": "boolean",
      "value": false,
      "display": "EULAへの同意 (true/false)",
      "desc": "<a href='https://account.mojang.com/documents/minecraft_eula'>Minecraft EULA</a> に同意しますか？",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "javaversion": {
      "type": "string",
      "value": "17",
      "display": "Javaバージョン",
      "desc": "使用するJavaのバージョン",
      "required": true,
      "userEdit": true
    },
    "jvmArgs": {
      "type": "string",
      "value": "-Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true",
      "display": "JVM引数",
      "desc": "追加で渡すJVM引数",
      "required": false,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 1024,
      "display": "メモリ (MB)",
      "desc": "Javaヒープに割り当てるメモリ容量（MB単位）",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "projectId": {
      "type": "integer",
      "value": 0,
      "display": "プロジェクトID",
      "desc": "対象ModパックのプロジェクトID。CurseForgeの各Modパックページの右側に記載されています。",
      "required": true,
      "userEdit": false
    },
    "fileId": {
      "type": "integer",
      "value": 0,
      "display": "ファイルID",
      "desc": "対象ModパックのファイルID。各ファイル用URLの末尾に記載されている数値です。",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "curseforge",
      "projectId": "${projectId}",
      "fileId": "${fileId}"
    },
    {
      "if": "!file_exists(\"server.properties\")",
      "type": "writefile",
      "text": "server-ip=${ip}\nserver-port=${port}\n",
      "target": "server.properties"
    },
    {
      "type": "writefile",
      "text": "eula=${eula}",
      "target": "eula.txt"
    }
  ],
  "run": {
    "command": [
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar fabric-server-launch.jar nogui",
        "if": "file_exists('fabric-server-launch.jar')"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui",
        "if": "file_exists('server.jar')"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/minecraftforge/forge/${resolvedForgeVersion}/unix_args.txt nogui",
        "if": "resolvedForgeVersion != ''"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/neoforged/neoforge/${resolvedNeoForgeVersion}/unix_args.txt nogui",
        "if": "resolvedNeoForgeVersion != ''"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui"
      }
    ],
    "pre": [
      {
          "type": "resolveforgeversion",
          "outputVariable": "resolvedForgeVersion"
      },
      {
        "type": "resolveneoforgeversion",
        "outputVariable": "resolvedNeoForgeVersion"
      }
    ],
    "stop": "stop",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "eclipse-temurin:${javaversion}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "eclipse-temurin:${javaversion}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  },
  "stats": {
    "type": "jcmd"
  },
  "query": {
    "type": "minecraft"
  }
}
