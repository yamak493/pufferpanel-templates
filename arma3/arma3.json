{
  "type": "srcds",
  "display": "ARMA3",
  "icon": "arma3",
  "data": {
    "config": {
      "type": "string",
      "value": "config.cfg",
      "display": "構成ファイル (Config File)",
      "desc": "使用する構成ファイルを指定します。注：config.cfg はサーバーインストール時に作成されます！",
      "required": false,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレスです",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 2302,
      "display": "ポート番号",
      "desc": "サーバーに使用するポート番号です",
      "required": true,
      "userEdit": false
    },
    "steam_user": {
      "type": "string",
      "value": "anonymous",
      "display": "Steamユーザー名",
      "desc": "Steamにログインするためのユーザー名です",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login ${steam_user} +app_update 233780 +quit"
      ]
    },
    {
      "type": "command",
      "commands": [
        "touch ./config.cfg",
        "touch ./parameters.txt"
      ]
    }
  ],
  "run": {
    "command": "./arma3server -ip=${ip} -port=${port} -config=${config} -par=parameters.txt",
    "stopCode": 2,
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
