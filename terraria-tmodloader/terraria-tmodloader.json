      "userEdit": false
    },
    "secure": {
      "type": "string",
      "value": "1",
      "display": "チート防止設定",
      "desc": "有効なら1、無効なら0を設定します",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "1",
          "display": "有効"
        },
        {
          "value": "0",
          "display": "無効"
        }
      ]
    },
    "seed": {
      "type": "string",
      "value": "VeryGoodStartingSeed",
      "display": "シード値",
      "desc": "この項目はワールド生成後に変更することはできません - ワールドのシード値です",
      "required": true,
      "userEdit": true
    },
    "sl": {
      "type": "string",
      "value": "1",
      "display": "液体の移動制限",
      "desc": "同時に移動する液体の最大量を制限します。有効にするとラグが軽減される場合がありますが、液体が落ち着くまでに時間がかかるようになります。",
      "required": true,
      "userEdit": true
    },
    "steam": {
      "type": "string",
      "value": "",
      "display": "Steam",
      "desc": "Steamサポートを有効にします",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "-steam",
          "display": "有効"
        },
        {
          "value": "",
          "display": "無効"
        }
      ]
    },
    "tversion": {
      "type": "string",
      "value": "v2026.02.3.0",
      "display": "tModLoaderのバージョン（最新のtModLoaderバージョンを設定してサポートを有効にしてください - https://github.com/tModLoader/tModLoader/releases/latest を参照）",
      "desc": "tModLoaderのバージョン",
      "required": false,
      "userEdit": false
    },
    "world": {
      "type": "string",
      "value": "Terraria-World-1",
      "display": "ワールド名",
      "desc": "ワールドの名前",
      "required": true,
      "userEdit": true
    },
    "wp": {
      "type": "string",
      "value": "worlds",
      "display": "ワールドパス",
      "desc": "ワールドフォルダの名前",
      "required": true,
      "userEdit": true
    },
    "arch": {
      "type": "option",
      "value": "x64",
      "display": "CPUアーキテクチャ",
      "desc": "マシンのCPUアーキテクチャ",
      "required": true,
      "userEdit": false,
      "options": [
        {
          "value": "arm",
          "display": "arm"
        },
        {
          "value": "arm64",
          "display": "arm64"
        },
        {
          "value": "x64",
          "display": "amd64"
        }
      ]
    },
    "dotnetversion": {
      "type": "string",
      "value": "8.0.0",
      "display": ".NETランタイムのバージョン",
      "desc": ".NETランタイムのバージョン",
      "required": true,
      "userEdit": false
    },
    "size": {
      "type": "option",
      "value": "3",
      "display": "ワールドサイズ",
      "desc": "作成するワールドのサイズ",
      "required": true,
      "userEdit": false,
      "options": [
        {
          "value": "1",
          "display": "小"
        },
        {
          "value": "2",
          "display": "中"
        },
        {
          "value": "3",
          "display": "大"
        }
      ]
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://github.com/tModLoader/tModLoader/releases/download/${tversion}/tModLoader.zip"
      ]
    },
    {
      "type": "extract",
      "source": "tModLoader.zip",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "rm tModLoader.zip",
        "mkdir -p ./${wp}"
      ]
    }
  ],
  "run": {
    "command": "dotnet tModLoader.dll -server ${steam} -ip ${ip} ${disableannouncementbox} -announcementboxrange ${abr} -config ./serverconfig.txt -autocreate ${size}",
    "stop": "exit",
    "pre": [
      {
        "type": "writefile",
        "target": "serverconfig.txt",
        "text": "world=${wp}/${world}.wld\nautocreate=${size}\nseed=${seed}\nworldname=${world}\ndifficulty=${difficulty}\nmaxplayers=${players}\nport=${port}\npassword=${password}\nmotd=${motd}\nworldpath=../${wp}\nbanlist=../${ban}\nsecure=${secure}\nlanguage=${lang}\nupnp=1\nnpcstream=${npcs}\npriority=3\nslowliquids=${sl}\nworldrollbackstokeep=${backups}"
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "mcr.microsoft.com/dotnet/runtime:${dotnetversion}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "mcr.microsoft.com/dotnet/runtime:${dotnetversion}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "tar"
    ]
  }
}
