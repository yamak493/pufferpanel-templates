{
  "type": "srcds",
  "display": "Counter Strike: Global Offensive",
  "icon": "csgo",
  "data": {
    "clientport": {
      "type": "integer",
      "value": 27016,
      "display": "クライアントポート",
      "desc": "クライアント接続に使用するポート番号です",
      "required": true,
      "userEdit": false
    },
    "gamemap": {
      "type": "string",
      "value": "de_dust2",
      "display": "マップ",
      "desc": "初期状態で読み込むマップを指定します",
      "required": true,
      "userEdit": true
    },
    "gamemode": {
      "type": "integer",
      "value": 0,
      "display": "ゲームモード (Gamemode)",
      "desc": "(上級者向け) ゲームモードを指定します",
      "required": true,
      "userEdit": true
    },
    "gametype": {
      "type": "integer",
      "value": 0,
      "display": "ゲームタイプ (Gametype)",
      "desc": "(上級者向け) ゲームタイプを指定します",
      "required": true,
      "userEdit": true
    },
    "gslt": {
      "type": "string",
      "value": "",
      "display": "GSLTトークン",
      "desc": "サーバーを公開するために必須です。未入力の場合はLAN内でのみプレイ可能です。http://steamcommunity.com/dev/managegameservers でトークンを取得してください",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレスです",
      "required": true,
      "userEdit": false
    },
    "mapgroup": {
      "type": "string",
      "value": "mg_active",
      "display": "マップグループ",
      "desc": "(上級者向け) マップグループを指定します",
      "required": true,
      "userEdit": true
    },
    "maxplayers": {
      "type": "integer",
      "value": 20,
      "display": "最大プレイヤー数",
      "desc": "サーバーに参加可能な最大人数です",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "ポート番号",
      "desc": "サーバーに使用するポート番号です",
      "required": true,
      "userEdit": false
    },
    "tickrate": {
      "type": "integer",
      "value": 64,
      "display": "チックレート (Tickrate)",
      "desc": "サーバーのチックレートを設定します",
      "required": true,
      "userEdit": true
    },
    "tvport": {
      "type": "integer",
      "value": 27017,
      "display": "GOTVポート",
      "desc": "GOTVの配信に使用するポート番号です",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 740 +quit"
      ]
    }
  ],
  "run": {
    "command": "./srcds_run -game csgo -usercon -strictportbind -ip ${ip} -port ${port} +clientport ${clientport} +tv_port ${tvport} +map ${gamemap} -maxplayers_override ${maxplayers} +sv_setsteamaccount ${gslt} -tickrate ${tickrate} +mapgroup ${mapgroup} +game_mode ${gamemode} +game_type ${gametype} -net_port_try 1 -norestart",
    "stop": "exit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd:ubuntu-20",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${clientport}:${clientport}/tcp",
      "0.0.0.0:${tvport}:${tvport}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd:ubuntu-20",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${clientport}:${clientport}/tcp",
        "0.0.0.0:${tvport}:${tvport}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
