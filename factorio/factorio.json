{
  "type": "factorio",
  "display": "Factorio",
  "icon": "factorio",
  "data": {
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 34197,
      "display": "ポート",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "save": {
      "type": "string",
      "value": "saves/default.zip",
      "display": "使用するセーブファイル",
      "desc": "読み込むセーブファイル（パス名）",
      "required": true,
      "userEdit": true
    },
    "server-settings": {
      "type": "string",
      "value": "factorio/data/server-settings.json",
      "display": "サーバー設定JSON",
      "desc": "サーバー設定ファイル（server-settings.json）の場所",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://www.factorio.com/get-download/latest/headless/linux64"
      ]
    },
    {
      "type": "move",
      "source": "factorio-headless_*.tar.xz",
      "target": "factorio-install.tar.xz"
    },
    {
      "type": "extract",
      "source": "factorio-install.tar.xz",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "cp -n factorio/data/server-settings.example.json factorio/data/server-settings.json",
        "chmod +x factorio/bin/x64/factorio",
        "factorio/bin/x64/factorio --create saves/default.zip"
      ]
    }
  ],
  "run": {
    "command": "factorio/bin/x64/factorio --port ${port} --bind ${ip} --start-server ${save} --server-settings ${server-settings}",
    "stop": "/quit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "pufferpanel/ubuntu",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "curl",
      "tar",
      "xz"
    ]
  }
}
