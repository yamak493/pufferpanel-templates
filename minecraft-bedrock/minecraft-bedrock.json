{
  "type": "minecraft-bedrock",
  "display": "Minecraft（統合版）[通常Ver]",
  "icon": "minecraft-bedrock",
  "data": {
    "allow-cheats": {
      "type": "boolean",
      "value": false,
      "display": "チートを許可",
      "desc": "有効にすると、コマンドなどのチート機能が使用可能になります。",
      "required": true,
      "userEdit": true
    },
    "default-player-permission-level": {
      "type": "string",
      "value": "member",
      "display": "デフォルトの権限レベル",
      "desc": "初めて参加するプレイヤーの権限レベルを設定します。",
      "required": true,
      "userEdit": true
    },
    "difficulty": {
      "type": "string",
      "value": "easy",
      "display": "難易度",
      "desc": "ワールドの難易度を設定します。",
      "required": true,
      "userEdit": true
    },
    "gamemode": {
      "type": "string",
      "value": "survival",
      "display": "ゲームモード",
      "desc": "新しいプレイヤーのゲームモードを設定します。",
      "required": true,
      "userEdit": true
    },
    "level-name": {
      "type": "string",
      "value": "Bedrock level",
      "display": "レベル名（ワールド名）",
      "desc": "ワールド保存フォルダの名前です。",
      "required": true,
      "userEdit": true
    },
    "level-seed": {
      "type": "string",
      "value": "",
      "display": "ワールドシード値",
      "desc": "ワールドをランダム生成する際のシード値を指定します（任意）。",
      "required": false,
      "userEdit": true
    },
    "max-players": {
      "type": "integer",
      "value": 10,
      "display": "最大プレイヤー数",
      "desc": "サーバーに参加できる最大人数を設定します。",
      "required": true,
      "userEdit": true
    },
    "max-threads": {
      "type": "integer",
      "value": 0,
      "display": "最大スレッド数",
      "desc": "サーバーが使用する最大スレッド数。0（または未指定）の場合は可能な限り使用します。",
      "required": true,
      "userEdit": true
    },
    "online-mode": {
      "type": "boolean",
      "value": true,
      "display": "オンラインモード",
      "desc": "プレイヤーにXBox Live認証を必須にするかどうかを設定します。",
      "required": true,
      "userEdit": true
    },
    "player-idle-timeout": {
      "type": "integer",
      "value": 30,
      "display": "無操作タイムアウト",
      "desc": "指定した分数プレイヤーが無操作の場合、サーバーから切断（キック）します。0に設定すると無期限になります。",
      "required": true,
      "userEdit": true
    },
    "server-name": {
      "type": "string",
      "value": "Dedicated Server",
      "display": "サーバー名",
      "desc": "サーバー名として使用されます。",
      "required": true,
      "userEdit": true
    },
    "server-port": {
      "type": "integer",
      "value": 19132,
      "display": "サーバーポート",
      "desc": "サーバーが待ち受けるIPv4ポート番号。",
      "required": true,
      "userEdit": false
    },
    "server-portv6": {
      "type": "integer",
      "value": 19133,
      "display": "Server Port (IPv6)",
      "desc": "Which IPv6 port the server should listen to.",
      "required": true,
      "userEdit": false
    },
    "texturepack-required": {
      "type": "boolean",
      "value": false,
      "display": "Force Server Texturepack",
      "desc": "Force clients to use texture packs in the current world",
      "required": true,
      "userEdit": true
    },
    "tick-distance": {
      "type": "integer",
      "value": 4,
      "display": "Tick Distance",
      "desc": "The world will be ticked this many chunks away from any player.",
      "required": true,
      "userEdit": true
    },
    "version": {
      "type": "string",
      "value": "1.21.102.1",
      "display": "Bedrock Version",
      "desc": "Version of the Minecraft Bedrock Server to use",
      "required": true,
      "userEdit": true
    },
    "view-distance": {
      "type": "integer",
      "value": 32,
      "display": "View Distance",
      "desc": "The maximum allowed view distance in number of chunks.",
      "required": true,
      "userEdit": true
    },
    "white-list": {
      "type": "boolean",
      "value": false,
      "display": "Whitelist",
      "desc": "If true then all connected players must be listed in the separate whitelist.json file.",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://www.minecraft.net/bedrockdedicatedserver/bin-linux/bedrock-server-${version}.zip"
      ]
    },
    {
      "type": "extract",
      "source": "bedrock-server-${version}.zip",
      "destination": ""
    },
    {
      "type": "writefile",
      "text": "server-name=${server-name}\ngamemode=${gamemode}\ndifficulty=${difficulty}\nallow-cheats=${allow-cheats}\nmax-players=${max-players}\nonline-mode=${online-mode}\nwhite-list=${white-list}\nserver-port=${server-port}\nserver-portv6=${server-portv6}\nview-distance=${view-distance}\ntick-distance=${tick-distance}\nplayer-idle-timeout=${player-idle-timeout}\nmax-threads=${max-threads}\nlevel-name=${level-name}\nlevel-seed=${level-seed}\ndefault-player-permission-level=${default-player-permission-level}\ntexturepack-required=${texturepack-required}\n",
      "target": "server.properties"
    }
  ],
  "run": {
    "command": "./bedrock_server",
    "stop": "stop",
    "environmentVars": {
      "LD_LIBRARY_PATH": "."
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "pufferpanel/ubuntu",
    "portBindings": [
      "0.0.0.0:${server-port}:${server-port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "pufferpanel/ubuntu",
      "portBindings": [
        "0.0.0.0:${server-port}:${server-port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "unzip"
    ]
  }
}