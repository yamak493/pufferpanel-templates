{
  "type": "minecraft-java",
  "display": "Minecraft（プロキシ）[BungeeCord]",
  "icon": "minecraft-java",
  "data": {
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 512,
      "display": "メモリ (MB)",
      "desc": "BungeeCordサーバーに割り当てるメモリ容量（MB単位）。一般的にはプレイヤー500人ごとに512MBのメモリを割り当てることが推奨されます。追加のプラグインを使用する場合は、より多くのメモリが必要になる場合があることに注意してください。",
      "required": true,
      "userEdit": false
    },
    "motd": {
      "type": "string",
      "value": "A BungeeCord Server &9hosted on PufferPanel",
      "display": "MOTD (今日のメッセージ)",
      "desc": "サーバーリストの名前の下に表示されるメッセージです。<a href='https://minecraft.wiki/w/Formatting_codes' target='_blank'>カラー・装飾コード</a>をサポートしています。",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25577,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "javaVersion": {
      "type": "string",
      "value": "21",
      "display": "Javaバージョン",
      "desc": "使用するJavaのバージョン",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "env == 'host' && javaVersion != ''",
      "type": "javadl",
      "version": "${javaVersion}"
    },
    {
      "type": "download",
      "files": [
        "http://ci.md-5.net/job/BungeeCord/lastSuccessfulBuild/artifact/bootstrap/target/BungeeCord.jar"
      ]
    },
    {
      "type": "writefile",
      "text": "listeners:\n- query_port: ${port}\n  host: ${ip}:${port}\n  motd: '${motd}'\n",
      "target": "config.yml"
    }
  ],
  "run": {
    "command": [
      {
        "command": "java${javaVersion} -Xmx${memory}M -Xms${memory}M -Dlog4j2.formatMsgNoLookups=true -jar BungeeCord.jar",
        "if": "env == 'host' && javaVersion != ''"
      },
      {
        "command": "java -Xmx${memory}M -Xms${memory}M -Dlog4j2.formatMsgNoLookups=true -jar BungeeCord.jar"
      }
    ],
    "stop": "end",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "eclipse-temurin:${javaVersion}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {}
}
