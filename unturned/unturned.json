{
  "type": "srcds",
  "display": "Unturned",
  "data": {
    "mapname": {
      "type": "option",
      "value": "PEI",
      "display": "マップ",
      "desc": "サーバーで使用するマップ",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "PEI",
          "display": "PEI"
        },
        {
          "value": "Germany",
          "display": "Germany"
        },
        {
          "value": "Russia",
          "display": "Russia"
        },
        {
          "value": "Washington",
          "display": "Washington"
        },
        {
          "value": "Yukon",
          "display": "Yukon"
        }
      ]
    },
    "maxplayers": {
      "type": "integer",
      "value": 24,
      "display": "サーバー枠数",
      "desc": "最大プレイヤー数（スロット）",
      "required": false,
      "userEdit": false
    },
    "mode": {
      "type": "option",
      "value": "normal",
      "display": "モード",
      "desc": "ゲームの難易度設定",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "easy",
          "display": "イージー"
        },
        {
          "value": "normal",
          "display": "ノーマル"
        },
        {
          "value": "hard",
          "display": "ハード"
        }
      ]
    },
    "name": {
      "type": "string",
      "value": "Unturned Server",
      "display": "サーバー名",
      "desc": "サーバーの表示名",
      "required": true,
      "userEdit": true
    },
    "password": {
      "type": "string",
      "value": "",
      "display": "サーバーパスワード",
      "desc": "プレイヤーが参加するために入力するパスワード",
      "required": false,
      "userEdit": true
    },
    "perspective": {
      "type": "option",
      "value": "",
      "display": "パースペクティブ（視点）",
      "desc": "サーバーでの視点制限設定",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "First",
          "display": "一人称視点（First Person）"
        },
        {
          "value": "Third",
          "display": "三人称視点（Third Person）"
        },
        {
          "value": "Both",
          "display": "両方可能"
        },
        {
          "value": "Vehicle",
          "display": "Vehicle"
        }
      ]
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Server port.",
      "required": true,
      "userEdit": false
    },
    "server": {
      "type": "string",
      "value": "Default",
      "display": "Server",
      "desc": "Server name under Servers folder",
      "required": false,
      "userEdit": true
    },
    "steam_id": {
      "type": "string",
      "value": "",
      "display": "STEAMID_64",
      "desc": "Server owner STEAMID_64",
      "required": true,
      "userEdit": true
    },
    "welcome": {
      "type": "string",
      "value": "Welcome to the server!",
      "display": "Server welcome message",
      "desc": "Welcome",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 1110390 validate +exit"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x ServerHelper.sh"
      ]
    },
    {
      "type": "mkdir",
      "target": "Servers/${server}/Server"
    },
    {
      "type": "writefile",
      "text": "Name ${name}\nMap ${mapname}\nPort ${port}\nMaxPlayers ${maxplayers}\nMode ${mode}\nOwner ${steam_id}\nWelcome ${welcome}\nPassword ${password}\nPerspective ${perspective}",
      "target": "/Servers/${server}/Server/Commands.dat"
    }
  ],
  "run": {
    "command": "./ServerHelper.sh",
    "stop": "shutdown",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
