{
  "type": "srcds",
  "display": "Counter Strike: Source",
  "icon": "css",
  "data": {
    "clientport": {
      "type": "integer",
      "value": 27005,
      "display": "クライアントポート",
      "desc": "バインドするクライアントポート番号",
      "required": true,
      "userEdit": false
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "mapName": {
      "type": "string",
      "value": "de_dust2",
      "display": "マップ名",
      "desc": "デフォルトで読み込むマップ",
      "required": true,
      "userEdit": true
    },
    "maxplayers": {
      "type": "integer",
      "value": 20,
      "display": "最大プレイヤー数",
      "desc": "サーバーに参加可能な最大人数",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "tickrate": {
      "type": "integer",
      "value": 66,
      "display": "チックレート",
      "desc": "サーバーの更新速度（チックレート）。この値を使用するにはアドオンが必要です: https://github.com/daemon32/tickrate_enabler/releases/tag/0.5",
      "required": true,
      "userEdit": true
    },
    "tvport": {
      "type": "integer",
      "value": 27020,
      "display": "SourceTVポート",
      "desc": "SourceTVをバインドするポート番号",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "232330"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 232330 +quit"
      ]
    }
  ],
  "run": {
    "command": "./srcds_run -game cstrike -ip ${ip} -port ${port} +clientport ${clientport} +tv_port ${tvport} +map ${mapName} -maxplayers ${maxplayers} -tickrate ${tickrate} -norestart",
    "stop": "exit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${clientport}:${clientport}/tcp",
        "0.0.0.0:${tvport}:${tvport}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
