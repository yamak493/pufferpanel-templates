{
  "type": "srcds",
  "display": "Team Fortress 2",
  "data": {
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "mapname": {
      "type": "string",
      "value": "ctf_2fort",
      "display": "読み込むマップ（Team Fortress 2）",
      "desc": "TF2のマップ名",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "ポート",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 232250 +quit"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x srcds_run"
      ]
    }
  ],
  "run": {
    "command": "./srcds_run +ip ${ip} +port ${port} -game tf -console +map ${mapname} -norestart",
    "stop": "exit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "pufferpanel/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "pufferpanel/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
