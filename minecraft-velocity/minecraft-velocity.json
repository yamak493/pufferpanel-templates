{
  "type": "minecraft-java",
  "display": "Minecraft（プロキシ）[Velocity]",
  "icon": "minecraft-java",
  "data": {
    "build": {
      "type": "string",
      "value": "latest",
      "display": "Velocityビルド",
      "desc": "使用するVelocityのビルド番号（`latest`推奨）",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 512,
      "display": "メモリ (MB)",
      "desc": "Velocityサーバーに割り当てるメモリ容量（MB単位）。一般的にはプレイヤー500人ごとに512MBのメモリを割り当てることが推奨されます。追加のプラグインを使用する場合は、より多くのメモリが必要になる場合があることに注意してください。",
      "required": true,
      "userEdit": false
    },
    "motd": {
      "type": "string",
      "value": "A Velocity proxy &9hosted on PufferPanel",
      "display": "MOTD (今日のメッセージ)",
      "desc": "サーバーリストの名前の下に表示されるメッセージです。<a href='https://minecraft.wiki/w/Formatting_codes' target='_blank'>カラー・装飾コード</a>をサポートしています。",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "string",
      "value": "latest",
      "display": "Velocityバージョン",
      "desc": "インストールするVelocityのバージョン",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "javadl",
      "version": "21"
    },
    {
      "type": "paperdl",
      "build": "${build}",
      "minecraftVersion": "${version}",
      "target": "velocity.jar",
      "project": "velocity"
    }
  ],
  "run": {
    "command": [
      {
        "command": "java21 -Xmx${memory}M -Xms${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true -jar velocity.jar",
        "if": "env == 'host'"
      },
      {
        "command": "java -Xmx${memory}M -Xms${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true -jar velocity.jar"
      }
    ],
    "stop": "shutdown",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "eclipse-temurin:21",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {},
  "stats": {
    "type": "jcmd"
  }
}
