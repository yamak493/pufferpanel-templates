    "motd": {
      "type": "string",
      "value": "Hello!",
      "display": "サーバーメッセージ（MOTD）",
      "desc": "今日のメッセージを設定します",
      "required": true,
      "userEdit": true
    },
    "npcs": {
      "type": "string",
      "value": "60",
      "display": "NPCストリーム（同期速度）",
      "desc": "敵がワープする現象を軽減しますが、帯域幅の使用量が増加します。数値が低いほどワープは少なくなりますが、より多くのデータが送信されます。0はオフです。",
      "required": true,
      "userEdit": true
    },
    "password": {
      "type": "string",
      "value": "",
      "display": "パスワード",
      "desc": "サーバーのパスワード - 空欄でパスワードなしになります",
      "required": true,
      "userEdit": true
    },
    "players": {
      "type": "string",
      "value": "4",
      "display": "最大プレイヤー数",
      "desc": "最大プレイヤー数",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "string",
      "value": "7777",
      "display": "ポート",
      "desc": "サーバーがバインドするポート",
      "required": true,
      "userEdit": false
    },
    "secure": {
      "type": "string",
      "value": "1",
      "display": "チート防止設定",
      "desc": "有効なら1、無効なら0を設定します",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "1",
          "display": "有効"
        },
        {
          "value": "0",
          "display": "無効"
        }
      ]
    },
    "seed": {
      "type": "string",
      "value": "VeryGoodStartingSeed",
      "display": "シード値",
      "desc": "ワールド生成後は変更できません。ワールドのシード値です。",
      "required": true,
      "userEdit": true
    },
    "size": {
      "type": "string",
      "value": "3",
      "display": "ワールドサイズ",
      "desc": "ワールド生成後は変更できません。ワールドサイズ (1-3、3が最大) です。",
      "required": true,
      "userEdit": true
    },
    "sl": {
      "type": "string",
      "value": "1",
      "display": "液体の移動制限",
      "desc": "同時に移動する液体の最大量を制限します。有効にするとラグが軽減される場合がありますが、液体が落ち着くまでに時間がかかるようになります。",
      "required": true,
      "userEdit": true
    },
    "steam": {
      "type": "string",
      "value": "-steam",
      "display": "Steam",
      "desc": "Steamサポートを有効にします",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "-steam",
          "display": "有効"
        },
        {
          "value": "",
          "display": "無効"
        }
      ]
    },
    "version": {
      "type": "string",
      "value": "1449",
      "display": "サーバーバージョン（最新のサーバーバージョンを設定してください） - ドットなしのTerrariaバージョンです（クライアント 1.4.3.2 -> サーバー 1432）",
      "desc": "サーバーバージョン",
      "required": true,
      "userEdit": true
    },
    "world": {
      "type": "string",
      "value": "Terraria-World-1",
      "display": "ワールド名",
      "desc": "ワールドの名前",
      "required": true,
      "userEdit": true
    },
    "wp": {
      "type": "string",
      "value": "worlds",
      "display": "ワールドパス",
      "desc": "ワールドフォルダの名前",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://terraria.org/api/download/pc-dedicated-server/terraria-server-${version}.zip"
      ]
    },
    {
      "type": "extract",
      "source": "terraria-server-${version}.zip",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "rm -rf ./server",
        "mkdir ./server",
        "cp -r ./${version}/Linux/. ./server",
        "chmod +x ./server/TerrariaServer",
        "chmod +x ./server/TerrariaServer.bin.x86_64",
        "mkdir ./${wp}",
        "rm terraria-server-${version}.zip",
        "rm -r ${version}"
      ]
    }
  ],
  "run": {
    "command": "./server/TerrariaServer -ip ${ip} ${steam} ${disableannouncementbox} -announcementboxrange ${abr} -config ../serverconfig.txt",
    "stop": "exit",
    "pre": [
      {
        "type": "writefile",
        "text": "world=../${wp}/${world}.wld\nautocreate=${size}\nseed=${seed}\nworldname=${world}\ndifficulty=${difficulty}\nmaxplayers=${players}\nport=${port}\npassword=${password}\nmotd=${motd}\nworldpath=../${wp}\nbanlist=../${ban}\nsecure=${secure}\nlanguage=${lang}\nupnp=1\nnpcstream=${npcs}\npriority=3\nslowliquids=${sl}\nworldrollbackstokeep=${backups}",
        "target": "serverconfig.txt"
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "pufferpanel/ubuntu",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "unzip"
    ]
  }
}
