{
  "type": "minecraft-java",
  "display": "Minecraft（Java版）[通常Ver]",
  "icon": "minecraft-java",
  "data": {
    "eula": {
      "type": "boolean",
      "value": false,
      "display": "EULAへの同意 (true/false)",
      "desc": "<a href='https://account.mojang.com/documents/minecraft_eula'>Minecraft EULA</a> に同意しますか？",
      "required": true,
      "userEdit": true
    },
    "forgebuild": {
      "type": "string",
      "value": "",
      "display": "Forgeバージョン",
      "desc": "インストールする <a href='http://files.minecraftforge.net/#Downloads'>Forgeのバージョン</a>。例: `1.21.8-58.1.0` (空白の場合は最新)",
      "required": false,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "javaversion": {
      "type": "string",
      "value": "25",
      "display": "Javaバージョン",
      "desc": "使用するJavaのバージョン",
      "required": true,
      "userEdit": true
    },
    "jvmArgs": {
      "type": "string",
      "value": "",
      "display": "JVM引数",
      "desc": "追加で渡すJVM引数",
      "required": false,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 2048,
      "display": "メモリ (MB)",
      "desc": "Javaヒープに割り当てるメモリ容量（MB単位）",
      "required": true,
      "userEdit": false
    },
    "modlauncher": {
      "type": "string",
      "value": "",
      "display": "Mod/プラグイン ローダー",
      "desc": "Minecraftと一緒にインストールするModまたはプラグインローダー",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "",
          "display": "なし (バニラ)"
        },
        {
          "value": "fabric",
          "display": "Fabric"
        },
        {
          "value": "forge",
          "display": "MinecraftForge"
        },
        {
          "value": "neoforge",
          "display": "NeoForge"
        },
        {
          "value": "paper",
          "display": "Paper"
        }
      ]
    },
    "motd": {
      "type": "string",
      "value": "A Minecraft Server\\n\\u00A79 hosted on PufferPanel",
      "display": "MOTD (今日のメッセージ)",
      "desc": "サーバーリストの名前の下に表示されるメッセージです。<a href='https://minecraft.wiki/w/Formatting_codes' target='_blank'>カラー・装飾コード</a>をサポートしています。",
      "required": true,
      "userEdit": true
    },
    "neobuild": {
      "type": "string",
      "value": "",
      "display": "NeoForgeバージョン",
      "desc": "インストールする <a href='https://neoforged.net/'>NeoForgeのバージョン</a>。例: `21.10.64` または `21.11.6-beta`",
      "required": false,
      "userEdit": true
    },
    "paperbuild": {
      "type": "string",
      "value": "latest",
      "display": "ビルド番号",
      "desc": "インストールするPaperのビルド（<a href='https://papermc.io/downloads'>Paperビルド一覧</a>）。`484`のようなビルド番号、または`latest`を指定してください。",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "string",
      "value": "latest",
      "display": "バージョン",
      "desc": "インストールするMinecraftのバージョン。`latest`は全てのサーバーソフトウェアで動作するとは限らないため、特定のバージョンを指定することを推奨します。",
      "required": true,
      "userEdit": true
    },
    "resolvedForgeVersion": {
      "type": "string",
      "value": "",
      "display": "Resolved Forge Version",
      "desc": "Internal, resolved version of Forge",
      "required": true,
      "userEdit": true,
      "internal": true
    },
    "resolvedNeoForgeVersion": {
      "type": "string",
      "value": "",
      "display": "Resolved NeoForge Version",
      "desc": "Internal, resolved version of NeoForge",
      "required": true,
      "userEdit": true,
      "internal": true
    }
  },
  "groups": [
    {
      "display": "基本設定",
      "description": "サーバーの全般的な設定",
      "variables": [
        "eula",
        "memory",
        "ip",
        "port",
        "motd",
        "version",
        "javaversion",
        "modlauncher",
        "jvmArgs"
      ],
      "order": 1
    },
    {
      "if": "modlauncher == 'forge'",
      "display": "Forge設定",
      "description": "MinecraftForgeを使用する場合の設定",
      "variables": [
        "forgebuild"
      ],
      "order": 2
    },
    {
      "if": "modlauncher == 'neoforge'",
      "display": "NeoForge設定",
      "description": "NeoForgeを使用する場合の設定",
      "variables": [
        "neobuild"
      ],
      "order": 2
    },
    {
      "if": "modlauncher == 'paper'",
      "display": "Paper設定",
      "description": "Paperを使用する場合の設定",
      "variables": [
        "paperbuild"
      ],
      "order": 3
    }
  ],
  "install": [
    {
      "if": "modlauncher == ''",
      "type": "mojangdl",
      "version": "${version}",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'fabric'",
      "type": "fabricdl"
    },
    {
      "if": "modlauncher == 'fabric'",
      "type": "command",
      "commands": [
        "java -jar fabric-installer.jar server -mcversion ${version} -downloadMinecraft -noprofile -loader latest"
      ]
    },
    {
      "if": "modlauncher == 'fabric'",
      "type": "mojangdl",
      "version": "${version}",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'forge'",
      "type": "forgedl",
      "target": "installer.jar",
      "version": "${forgebuild}",
      "minecraftVersion": "${version}",
      "outputVariable": "resolvedForgeVersion"
    },
    {
      "if": "modlauncher == 'forge'",
      "type": "command",
      "commands": [
        "java -jar installer.jar --installServer"
      ]
    },
    {
      "if": "modlauncher == 'forge' && file_exists('forge-' + resolvedForgeVersion + '-shim.jar')",
      "type": "move",
      "source": "forge-${resolvedForgeVersion}-shim.jar",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'forge' && file_exists('forge-' + resolvedForgeVersion + '.jar')",
      "type": "move",
      "source": "forge-${resolvedForgeVersion}.jar",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'neoforge'",
      "type": "neoforgedl",
      "target": "installer.jar",
      "version": "${neobuild}",
      "minecraftVersion": "${version}",
      "outputVariable": "resolvedNeoForgeVersion"
    },
    {
      "if": "modlauncher == 'neoforge'",
      "type": "command",
      "commands": [
        "java -jar installer.jar --installServer"
      ]
    },    
    {
      "if": "modlauncher == 'paper'",
      "type": "paperdl",
      "build": "${paperbuild}",
      "minecraftVersion": "${version}",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'spigot'",
      "type": "download",
      "files": [
        "https://hub.spigotmc.org/jenkins/job/BuildTools/lastSuccessfulBuild/artifact/target/BuildTools.jar"
      ]
    },
    {
      "if": "modlauncher == 'spigot'",
      "type": "command",
      "commands": [
        "java -jar BuildTools.jar --rev ${version}"
      ]
    },
    {
      "if": "modlauncher == 'spigot'",
      "type": "move",
      "source": "spigot-*.jar",
      "target": "server.jar"
    },
    {
      "if": "!file_exists(\"server.properties\")",
      "type": "writefile",
      "text": "server-ip=${ip}\nserver-port=${port}\nmotd=${motd}\n",
      "target": "server.properties"
    },
    {
      "type": "writefile",
      "text": "eula=${eula}",
      "target": "eula.txt"
    }
  ],
  "run": {
    "command": [
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar fabric-server-launch.jar nogui",
        "if": "file_exists('fabric-server-launch.jar')"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui",
        "if": "file_exists('server.jar')"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/minecraftforge/forge/${resolvedForgeVersion}/unix_args.txt nogui",
        "if": "modlauncher == 'forge' && file_exists('libraries/net/minecraftforge/forge/' + resolvedForgeVersion + '/unix_args.txt')"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/neoforged/neoforge/${resolvedNeoForgeVersion}/unix_args.txt nogui",
        "if": "modlauncher == 'neoforge' && file_exists('libraries/net/neoforged/neoforge/' + resolvedNeoForgeVersion+ '/unix_args.txt')"
      },
      {
        "command": "java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui"
      }
    ],
    "pre": [
      {
          "if": "modlauncher == 'forge'",
          "type": "resolveforgeversion",
          "minecraftVersion": "${version}",
          "version": "${forgebuild}",
          "outputVariable": "resolvedForgeVersion"
      },
      {
          "if": "modlauncher == 'neoforge'",
          "type": "resolveneoforgeversion",
          "minecraftVersion": "${version}",
          "version": "${neobuild}",
          "outputVariable": "resolvedNeoForgeVersion"
      }
    ],
    "stop": "stop",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "eclipse-temurin:${javaversion}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "eclipse-temurin:${javaversion}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  },
  "stats": {
    "type": "jcmd"
  },
  "query": {
    "type": "minecraft"
  }
}
