{
  "type": "srcds",
  "display": "Eco 9 Beta Version",
  "icon": "eco",
  "data": {
    "ServerName": {
      "type": "string",
      "value": "",
      "display": "サーバー名",
      "desc": "サーバーの名前を設定します",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "EcoゲームサーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "maxcon": {
      "type": "integer",
      "value": -1,
      "display": "最大接続数",
      "desc": "サーバーへの最大同時接続数（プレイヤー制限、-1は無制限）",
      "required": true,
      "userEdit": true
    },
    "password": {
      "type": "string",
      "value": "",
      "display": "パスワード",
      "desc": "Ecoゲームサーバーへのログイン用パスワード",
      "required": false,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 3000,
      "display": "ゲームサーバーポート（要ポート開放）",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "upnp": {
      "type": "boolean",
      "value": false,
      "display": "uPnPを有効にしますか？",
      "desc": "uPnP（ユニバーサル・プラグ・アンド・プレイ）を有効にするかどうか",
      "required": true,
      "userEdit": false
    },
    "webServerPort": {
      "type": "integer",
      "value": 3001,
      "display": "Webサーバーポート",
      "desc": "Ecoウェブサーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "739590"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 739590 -beta default validate +quit"
      ]
    },
    {
      "type": "writefile",
      "target": "Configs/Network.eco",
      "text": "{\n  \"PublicServer\": false,\n  \"Password\": \"${password}\",\n  \"Description\": \"${ServerName}\",\n  \"IPAddress\": \"${ip}\",\n  \"GameServerPort\": ${port},\n  \"WebServerPort\": ${webServerPort},\n  \"Rate\": 10,\n  \"MaxConnections\": ${maxcon},\n \"UPnPEnabled\": ${upnp}\n}"
    },
    {
      "type": "command",
      "commands": [
        "chmod +x EcoServer"
      ]
    }
  ],
  "run": {
    "command": "./EcoServer",
    "stopCode": 2,
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
