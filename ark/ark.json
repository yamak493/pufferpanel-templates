{
  "type": "srcds",
  "display": "ARK: Survival Evolved",
  "icon": "ark",
  "data": {
    "exclusive": {
      "type": "option",
      "value": "",
      "display": "参加限定設定 (Exclusive)",
      "desc": "フレンドのみの参加を許可する場合は 'Yes' (はい)、パブリック公開にする場合は 'No' (いいえ) を選択してください",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "",
          "display": "No (いいえ)"
        },
        {
          "value": "-exclusivejoin",
          "display": "Yes (はい)"
        }
      ]
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレスを指定します",
      "required": true,
      "userEdit": true
    },
    "mapname": {
      "type": "string",
      "value": "TheIsland",
      "display": "マップ名",
      "desc": "読み込むマップの名前を指定します",
      "required": true,
      "userEdit": true
    },
    "maxplayers": {
      "type": "integer",
      "value": 20,
      "display": "最大プレイヤー数",
      "desc": "同時接続可能な最大プレイヤー数を設定します",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "接続ポート",
      "desc": "サーバーとの通信に使用するポート番号を指定します",
      "required": true,
      "userEdit": true
    },
    "queryport": {
      "type": "integer",
      "value": 27015,
      "display": "クエリポート",
      "desc": "サーバー情報の照会に使用するポート番号を指定します",
      "required": true,
      "userEdit": true
    },
    "serveradminpassword": {
      "type": "string",
      "value": "password",
      "display": "管理者用パスワード",
      "desc": "管理コマンド（admin command）を実行するためのパスワードです",
      "required": true,
      "userEdit": true
    },
    "sessionname": {
      "type": "string",
      "value": "My ARK Server",
      "display": "セッション名（サーバー名）",
      "desc": "サーバー一覧に表示されるサーバー名です",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 376030 +quit"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x ShooterGame/Binaries/Linux/ShooterGameServer"
      ]
    }
  ],
  "run": {
    "command": "./ShooterGame/Binaries/Linux/ShooterGameServer ${mapname}?listen?SessionName=${sessionname}?ServerAdminPassword=${serveradminpassword}?MultiHome=${ip}?Port=${port}?QueryPort=${queryport}?MaxPlayers=${maxplayers} -server ${exclusive}",
    "stopCode": 2,
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${queryport}:${queryport}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${queryport}:${queryport}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
