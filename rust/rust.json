{
  "type": "srcds",
  "display": "Rust",
  "icon": "rust",
  "data": {
    "Description": {
      "type": "string",
      "value": "RUST Public Server Description",
      "display": "サーバーの説明欄",
      "desc": "サーバーブラウザに表示されるサーバーの説明文です",
      "required": true,
      "userEdit": true
    },
    "MaxPlayers": {
      "type": "integer",
      "value": 10,
      "display": "最大プレイヤー数",
      "desc": "サーバーが許容する最大接続人数です",
      "required": true,
      "userEdit": false
    },
    "RConPassword": {
      "type": "string",
      "value": "",
      "display": "RCONパスワード",
      "desc": "RCON（リモートコンソール）で使用するパスワードです。必ず変更してください",
      "required": true,
      "userEdit": true
    },
    "RConPort": {
      "type": "integer",
      "value": 28016,
      "display": "RCONポート",
      "desc": "RCON接続に使用するポート番号です",
      "required": true,
      "userEdit": false
    },
    "ServerIdentity": {
      "type": "string",
      "value": "server1",
      "display": "サーバー識別子 (Server Identity)",
      "desc": "サーバーの識別用名称です。よく分からない場合はデフォルトのままにしてください",
      "required": true,
      "userEdit": false
    },
    "ServerImage": {
      "type": "string",
      "value": "http://",
      "display": "サーバーヘッダー画像",
      "desc": "サーバー詳細に表示されるバナー画像のURLを指定します",
      "required": true,
      "userEdit": true
    },
    "ServerLevel": {
      "type": "string",
      "value": "Procedural Map",
      "display": "サーバーレベル（マップ）",
      "desc": "使用するマップ名を指定します。不明な場合はデフォルトのままにしてください",
      "required": true,
      "userEdit": true
    },
    "ServerName": {
      "type": "string",
      "value": "RUST Public Server",
      "display": "サーバー名",
      "desc": "サーバーブラウザに表示される名称を設定します",
      "required": true,
      "userEdit": true
    },
    "ServerSeed": {
      "type": "string",
      "value": "1234",
      "display": "サーバーシード値",
      "desc": "マップ生成に使用するシード値です。デフォルトでも問題ありません",
      "required": true,
      "userEdit": true
    },
    "URL": {
      "type": "string",
      "value": "http://",
      "display": "サーバーWebサイト",
      "desc": "このサーバー専用のWebサイト等がある場合にURLを指定します",
      "required": true,
      "userEdit": true
    },
    "WorldSize": {
      "type": "integer",
      "value": 3000,
      "display": "ワールドサイズ",
      "desc": "ワールドの広さを指定します（数値）",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPプロトコル",
      "desc": "サーバーをバインドするIPアドレスを指定します",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "What port to bind the server to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "steamgamedl",
      "appId": "258550"
    },
    {
      "if": "env == 'docker'",
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 258550 +quit"
      ]
    }
  ],
  "run": {
    "command": "./RustDedicated -nographics -batchmode +server.port ${port} +server.level \"${ServerLevel}\" +server.seed ${ServerSeed} +server.worldsize ${WorldSize} +server.maxplayers ${MaxPlayers} +server.hostname \"${ServerName}\" +server.description \"${Description}\" +server.headerimage \"${ServerImage}\" +server.url \"${URL}\" +server.identity \"${ServerIdentity}\" +rcon.port ${RConPort} +rcon.password ${RConPassword} +rcon.web 1",
    "stop": "quit",
    "environmentVars": {
      "LD_LIBRARY_PATH": "./RustDedicated_Data/Plugins/x86_64"
    },
    "stdin": {
      "type": "rconws",
      "port": "${RConPort}",
      "password": "${RConPassword}"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
