{
  "type": "terraria",
  "display": "Terraria [TShock]",
  "icon": "terraria",
  "data": {
    "arch": {
      "type": "option",
      "value": "x64",
      "display": "CPUアーキテクチャ",
      "desc": "マシンのCPUアーキテクチャ",
      "required": true,
      "userEdit": false,
      "options": [
        {
          "value": "arm64",
          "display": "arm64"
        },
        {
          "value": "x64",
          "display": "amd64"
        }
      ]
    },
    "dotnetversion": {
      "type": "string",
      "value": "6.0.14",
      "display": ".NETランタイムのバージョン",
      "desc": ".NETランタイムのバージョン",
      "required": true,
      "userEdit": false
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーがリッスンするIPアドレスを設定します - 0.0.0.0 は利用可能なすべてのIPを意味します",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "ポート",
      "desc": "サーバーがバインドするポート",
      "required": true,
      "userEdit": false
    },
    "secure": {
      "type": "option",
      "value": "",
      "display": "チート防止設定",
      "desc": "チート保護を有効にしますか？",
      "required": true,
      "userEdit": false,
      "options": [
        {
          "value": "-secure",
          "display": "はい"
        },
        {
          "value": "",
          "display": "いいえ"
        }
      ]
    },
    "tshockversion": {
      "type": "string",
      "value": "5.1.3",
      "display": "TShockのバージョン（最新のサーバーバージョンを設定してください - https://github.com/Pryaxis/TShock/releases/latest を参照）",
      "desc": "TShockのバージョン",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "string",
      "value": "1.4.4.9",
      "display": "サーバーバージョン",
      "desc": "サーバーバージョン（最新のサーバーバージョンを設定してください）",
      "required": true,
      "userEdit": false
    },
    "wsize": {
      "type": "option",
      "value": "3",
      "display": "ワールドサイズ",
      "desc": "作成するワールドのサイズ",
      "required": true,
      "userEdit": false,
      "options": [
        {
          "value": "1",
          "display": "小"
        },
        {
          "value": "2",
          "display": "中"
        },
        {
          "value": "3",
          "display": "大"
        }
      ]
    }
  },
  "install": [
    {
      "if": "env == 'host'",
      "type": "download",
      "files": [
        "https://dotnetcli.azureedge.net/dotnet/Runtime/${dotnetversion}/dotnet-runtime-${dotnetversion}-linux-${arch}.tar.gz"
      ]
    },
    {
      "if": "env == 'host'",
      "type": "command",
      "commands": [
        "rm -rf dotnet",
        "mkdir -p dotnet"
      ]
    },
    {
      "if": "env == 'host'",
      "type": "extract",
      "source": "dotnet-runtime-${dotnetversion}-linux-${arch}.tar.gz",
      "destination": "dotnet"
    },
    {
      "if": "env == 'host'",
      "type": "command",
      "commands": [
        "rm -rf dotnet-runtime-linux-${arch}.tar.gz"
      ]
    },
    {
      "type": "download",
      "files": [
        "https://github.com/Pryaxis/TShock/releases/download/v${tshockversion}/TShock-${tshockversion}-for-Terraria-${version}-linux-${arch}-Release.zip"
      ]
    },
    {
      "type": "extract",
      "source": "TShock-${tshockversion}-for-Terraria-${version}-linux-${arch}-Release.zip",
      "destination": "."
    },
    {
      "type": "extract",
      "source": "TShock-Beta-linux-${arch}-Release.tar",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "mkdir worlds",
        "rm -rf TShock-${tshockversion}-for-Terraria-${version}-linux-${arch}-Release.zip",
        "rm -rf TShock-Beta-linux-${arch}-Release.tar"
      ]
    }
  ],
  "run": {
    "command": [
      {
        "command": "./TShock.Server -ip ${ip} -port ${port} -world /pufferpanel/worlds/world.wld -autocreate ${wsize} ${secure} --stats-optout",
        "if": "env == 'docker'"
      },
      {
        "command": "./TShock.Server -ip ${ip} -port ${port} -world ${rootDir}/worlds/world.wld -autocreate ${wsize} ${secure} --stats-optout"
      }
    ],
    "stop": "exit",
    "environmentVars": {
      "DOTNET_ROOT": "./dotnet"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "mcr.microsoft.com/dotnet/runtime:${dotnetversion}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "unzip"
    ]
  }
}
