{
  "type": "minecraft-java",
  "display": "Minecraft（プロキシ）[Waterfall]",
  "icon": "minecraft-java",
  "data": {
    "build": {
      "type": "string",
      "value": "510",
      "display": "ビルド番号",
      "desc": "Waterfallのビルド番号",
      "required": true,
      "userEdit": false
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IPアドレス",
      "desc": "サーバーをバインドするIPアドレス",
      "required": true,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 512,
      "display": "メモリ (MB)",
      "desc": "Waterfallサーバーに割り当てるメモリ容量（MB単位）。一般的にはプレイヤー500人ごとに512MBのメモリを割り当てることが推奨されます。追加のプラグインを使用する場合は、より多くのメモリが必要になる場合があることに注意してください。",
      "required": true,
      "userEdit": false
    },
    "motd": {
      "type": "string",
      "value": "A Waterfall Server &9hosted on PufferPanel",
      "display": "MOTD (今日のメッセージ)",
      "desc": "サーバーリストの名前の下に表示されるメッセージです。<a href='https://minecraft.wiki/w/Formatting_codes' target='_blank'>カラー・装飾コード</a>をサポートしています。",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 25577,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "string",
      "value": "1.19",
      "display": "バージョン",
      "desc": "インストールするMinecraftのバージョン（マイナーリリース番号で指定、例: 1.16）",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://api.papermc.io/v2/projects/waterfall/versions/${version}/builds/${build}/downloads/waterfall-${version}-${build}.jar"
      ]
    },
    {
      "type": "move",
      "target": "Waterfall.jar",
      "source": "waterfall-*.jar"
    },
    {
      "type": "writefile",
      "text": "listeners:\n- query_port: ${port}\n  host: ${ip}:${port}\n  motd: '${motd}'\n",
      "target": "config.yml"
    }
  ],
  "run": {
    "command": "java -Xmx${memory}M -Xms${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true -jar Waterfall.jar",
    "stop": "end",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "eclipse-temurin:17",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "eclipse-temurin:17",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  },
  "stats": {
    "type": "jcmd"
  }
}
