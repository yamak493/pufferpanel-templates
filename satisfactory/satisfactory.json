{
  "type": "srcds",
  "display": "Satisfactory",
  "data": {
    "multihome": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "マルチホーム",
      "desc": "サーバーをバインドするIPアドレス",
      "required": false,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 15777,
      "display": "サーバークエリポート",
      "desc": "サーバーをバインドするポート番号",
      "required": false,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 1690800 +quit",
        "chmod +x Engine/Binaries/Linux/FactoryServer-Linux-Shipping",
        "mkdir -p ./FactoryGame/Saved/Config/LinuxServer/"
      ]
    }
  ],
  "run": {
    "command": "./Engine/Binaries/Linux/FactoryServer-Linux-Shipping FactoryGame ?listen -multihome=${multihome} -ServerQueryPort=${port}",
    "stopCode": 15,
    "environmentVars": {
      "LD_LIBRARY_PATH": "./linux64"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
