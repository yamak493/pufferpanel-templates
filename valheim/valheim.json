{
  "type": "valheim",
  "display": "Valheim",
  "data": {
    "modpack": {
      "type": "string",
      "value": "",
      "display": "使用するModパック(BepInEx)",
      "desc": "https://valheim.thunderstore.io/package/denikson/BepInExPack_Valheim/ を開き、「manual download」を右クリックしてリンクをコピーし、ここに貼り付けてください（Modを使用する場合）。",
      "required": false,
      "userEdit": true
    },
    "name": {
      "type": "string",
      "value": "Valheim Server",
      "display": "サーバー名",
      "desc": "サーバーの表示名を設定します。",
      "required": true,
      "userEdit": true
    },
    "password": {
      "type": "string",
      "value": "valheim",
      "display": "パスワード",
      "desc": "サーバーの参加パスワードを設定します。",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 2456,
      "display": "ポート番号",
      "desc": "サーバーをバインドするポート番号。",
      "required": true,
      "userEdit": false
    },
    "world": {
      "type": "string",
      "value": "VHWorld",
      "display": "ワールド名",
      "desc": "使用するワールドマップの名前を設定します。",
      "required": true,
      "userEdit": true
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "steamcmd +force_install_dir /pufferpanel +login anonymous +app_update 896660 +quit"
      ]
    },
    {
      "if": "modpack != ''",
      "type": "download",
      "files": [
        "${modpack}"
      ]
    },
    {
      "if": "modpack != ''",
      "type": "command",
      "commands": [
        "unzip ./denikson-BepInExPack_Valheim*.zip -d ./bepin_temp/",
        "cp -r ./bepin_temp/BepInExPack_Valheim/. ./",
        "rm -r ./bepin_temp"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x valheim_server.x86_64"
      ]
    }
  ],
  "run": {
    "command": "./valheim_server.x86_64 -name ${name} -port ${port} -world ${world} -password ${password} -public 1",
    "stopCode": 2,
    "environmentVars": {
      "LD_LIBRARY_PATH": "./linux64:$LD_LIBRARY_PATH"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "steamcmd/steamcmd",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "steamcmd/steamcmd",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64",
    "binaries": [
      "unzip"
    ]
  }
}